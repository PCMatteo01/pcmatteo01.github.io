---
import '../styles/global.css';
import { links } from '../data/content';
import { languages, localePath, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path?: string;
  /** project slug: switches the page to that project's own look */
  project?: string;
  /** home: the header floats over the hero instead of taking its own row */
  overlay?: boolean;
}

const { lang, path = '/', project, overlay = false } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'it' : 'en';
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(localePath(lang, path), site).href;

const home = path === '/' ? '' : localePath(lang, '/');
const nav = [
  ['projects', t.nav.projects],
  ['models', t.nav.models],
  ['about', t.nav.about],
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // The saved theme is applied before the first paint (dark is the default).
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t.siteTitle}</title>
    <meta name="description" content={t.siteDescription} />
    <link rel="canonical" href={canonical} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.siteTitle} />
    <meta property="og:description" content={t.siteDescription} />
    <meta property="og:image" content={new URL('/assets/projects/normandia.png', site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-project={project}>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header" data-header>
      <a class="site-header__name" href={`${home}#top`}><i aria-hidden="true"></i>Matteo Battiston</a>
      <nav class="site-header__nav" aria-label="Sections">
        {nav.map(([id, label]) => <a href={`${home}#${id}`} data-nav={id}>{label}</a>)}
      </nav>
      <div class="site-header__tools">
        <button type="button" class="theme-btn" data-theme-toggle data-to-dark={t.themeDark} data-to-light={t.themeLight} aria-label={t.themeLight}>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <div class="lang" role="group" aria-label="Language">
          <a href={localePath('en', path)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
          <a href={localePath('it', path)} hreflang="it" lang="it" aria-current={lang === 'it' ? 'true' : 'false'}>IT</a>
        </div>
        <button type="button" class="btn btn--primary btn--sm" aria-expanded="false" aria-controls="contact-panel" data-contact-toggle>
          {t.nav.contact}
        </button>
      </div>

      <div id="contact-panel" class="contact-panel" hidden data-contact-panel>
        <p class="contact-panel__title">{t.contactTitle}</p>
        <p class="contact-panel__open"><i aria-hidden="true"></i>{t.openTo}</p>
        <ul class="contact-panel__list">
          <li class="contact-row">
            <a href={`mailto:${links.email}`}><span>Email</span><strong>{links.email}</strong></a>
            <button type="button" class="contact-row__copy" data-copy={links.email} data-copied={t.contactCopied}>{t.contactCopy}</button>
          </li>
          <li class="contact-row"><a href={links.linkedin} target="_blank" rel="noopener"><span>LinkedIn</span><strong>in/battiston-matteo</strong></a></li>
          <li class="contact-row"><a href={links.github} target="_blank" rel="noopener"><span>GitHub</span><strong>PCMatteo01</strong></a></li>
          <li class="contact-row"><a href={links.sketchfab} target="_blank" rel="noopener"><span>Sketchfab</span><strong>battistonmatteo</strong></a></li>
        </ul>
      </div>
    </header>

    <main id="main" class={overlay ? undefined : 'with-header'}>
      <slot />
    </main>

    <footer id="contact" class="footer">
      <div class="footer__inner">
        <p class="kicker">{t.contactLabel}</p>
        <a class="footer__mail" href={`mailto:${links.email}`}>{links.email}</a>
        <div class="footer__row">
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={links.github} target="_blank" rel="noopener">GitHub</a>
          <a href={links.sketchfab} target="_blank" rel="noopener">Sketchfab</a>
          <span class="footer__role">{t.role}</span>
        </div>
      </div>
    </footer>
    <script>
      // Light / dark: the whole site follows, including the look of the panels.
      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const syncTheme = () => {
        const light = document.documentElement.dataset.theme === 'light';
        themeBtn?.setAttribute('aria-label', (light ? themeBtn.dataset.toDark : themeBtn.dataset.toLight) ?? '');
        themeBtn?.setAttribute('aria-pressed', String(light));
      };
      syncTheme();
      themeBtn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncTheme();
      });
    </script>
    <script>
      const header = document.querySelector<HTMLElement>('[data-header]')!;
      const toggle = document.querySelector<HTMLButtonElement>('[data-contact-toggle]')!;
      const panel = document.querySelector<HTMLElement>('[data-contact-panel]')!;

      // Contact panel: opens under the bar, closes on Esc, a click outside, or a link
      const setOpen = (open: boolean) => {
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        header.classList.toggle('is-open', open);
        if (open) header.classList.remove('is-hidden');
      };
      toggle.addEventListener('click', () => setOpen(panel.hidden));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      document.addEventListener('click', (e) => { if (!panel.hidden && !header.contains(e.target as Node)) setOpen(false); });
      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      panel.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
        b.addEventListener('click', async () => {
          const label = b.textContent;
          try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = b.dataset.copied!; } catch { return; }
          setTimeout(() => (b.textContent = label), 1600);
        });
      });

      // The bar slides away while you read down the page and comes back as soon as you scroll up
      let lastY = window.scrollY;
      addEventListener('scroll', () => {
        const y = window.scrollY;
        header.classList.toggle('is-scrolled', y > 24);
        if (!panel.hidden) { lastY = y; return; }
        if (y > 160 && y > lastY + 6) header.classList.add('is-hidden');
        else if (y < lastY - 6 || y <= 160) header.classList.remove('is-hidden');
        lastY = y;
      }, { passive: true });
      header.classList.toggle('is-scrolled', window.scrollY > 24);

      // Mark the link of the section in view
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
      const sections = links.map((a) => document.getElementById(a.dataset.nav!)).filter(Boolean) as HTMLElement[];
      if (sections.length) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.nav === e.target.id)));
        }, { rootMargin: '-45% 0px -50% 0px' });
        sections.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
