---
import '../styles/global.css';
import { links } from '../data/content';
import { languages, localePath, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path?: string;
  /** project slug: switches the page to that project's own look */
  project?: string;
}

const { lang, path = '/', project } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'it' : 'en';
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(localePath(lang, path), site).href;

const home = path === '/' ? '' : localePath(lang, '/');
const nav = [
  ['projects', t.nav.projects],
  ['models', t.nav.models],
  ['about', t.nav.about],
  ['contact', t.nav.contact],
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint (dark is the default).
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t.siteTitle}</title>
    <meta name="description" content={t.siteDescription} />
    <link rel="canonical" href={canonical} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site).href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.siteTitle} />
    <meta property="og:description" content={t.siteDescription} />
    <meta property="og:image" content={new URL('/assets/projects/normandia.png', site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-project={project}>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="bar">
      <a class="bar__name" href={`${home}#top`}>M. Battiston</a>
      <nav class="bar__nav" aria-label="Sections">
        {nav.map(([id, label]) => <a href={`${home}#${id}`} data-nav={id}>{label}</a>)}
      </nav>
      <div class="bar__tools">
        <button type="button" class="theme" data-theme-toggle data-to-dark={t.themeDark} data-to-light={t.themeLight} aria-label={t.themeLight}>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <div class="lang-switch" role="group" aria-label="Language">
          <a class="lang-switch__opt" href={localePath('en', path)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : 'false'}>ENG</a>
          <a class="lang-switch__opt" href={localePath('it', path)} hreflang="it" lang="it" aria-current={lang === 'it' ? 'true' : 'false'}>ITA</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer id="contact" class="foot">
      <p class="foot__label">{t.contactLabel}</p>
      <a class="foot__cta" href={`mailto:${links.email}`}>{links.email}</a>
      <div class="foot__row">
        <a class="btn win" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn win" href={links.github} target="_blank" rel="noopener">GitHub</a>
        <a class="btn win" href={links.sketchfab} target="_blank" rel="noopener">Sketchfab</a>
        <span class="foot__role">{t.role}</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const sync = () => {
        const light = root.dataset.theme === 'light';
        toggle.setAttribute('aria-label', (light ? toggle.dataset.toDark : toggle.dataset.toLight) ?? '');
      };
      sync();
      toggle.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        sync();
      });
    </script>
    <script>
      // Mark the top-bar link of the section that is currently in view.
      const links = document.querySelectorAll<HTMLAnchorElement>('.bar [data-nav]');
      const sections = [...links].map((a) => document.getElementById(a.dataset.nav!)).filter(Boolean) as HTMLElement[];
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.nav === e.target.id)));
          }
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      sections.forEach((s) => io.observe(s));
    </script>
  </body>
</html>
