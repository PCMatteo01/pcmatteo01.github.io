---
import Base from '../layouts/Base.astro';
import '../styles/project.css';
import Media from './Media.astro';
import { models, projects } from '../data/content';
import { localePath, useT, type Lang } from '../i18n/ui';
import { detailCode } from '../data/code';
import { highlight } from '../lib/highlight';

interface Props {
  lang: Lang;
  slug: string;
  /** pages with a lot of art get a second page: 'art' shows the compares and models, 'main' everything else */
  part?: 'main' | 'art';
}

const { lang, slug, part = 'main' } = Astro.props;
const t = useT(lang);

const files = import.meta.glob('../data/projects/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/projects/${slug}.json`];
const L = (x: { en: string; it: string } | null | undefined) => (x ? x[lang] : '');

const meta = projects.find((p) => p.slug === slug)!;
const index = projects.findIndex((p) => p.slug === slug);
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const isRender = meta.platforms.includes('3d');
const home = localePath(lang, '/');
const hrefOf = (s: string) => localePath(lang, `/projects/${s}/`);

const tagLabel: Record<string, string> = { pc: 'PC', xr: 'XR', '3d': '3D' };
const lead = data.intro.find((p: any) => p.lead) ?? data.intro[0];
const rest = data.intro.filter((p: any) => p !== lead);
// the role is told in its own box below, so it is not repeated in the strip
const facts = (data.facts ?? []).filter((f: any) => !(data.role && f.k.en === 'Role'));
const SHOW_ART_SPECS = false;
const hasArtPage = slug === 'lastgunner';
const isArt = part === 'art';
const isArtGroup = (g: any) => g.compares.length > 0 || g.models.length > 0;
const groups = hasArtPage ? data.groups.filter((g: any) => (isArt ? isArtGroup(g) : !isArtGroup(g))) : data.groups;
const groupModels = (g: any) => g.models.map((s: string) => models.find((m) => m.id === s)).filter(Boolean);
---

<Base lang={lang} path={`/projects/${slug}/`} project={slug}>
  <article class="proj">
    {isArt ? (
      <header class="proj__head">
        <a class="back" href={hrefOf(slug)}>{t.artBack}</a>
        <p class="kicker">{meta.title}</p>
        <h1 class="proj__title">{t.artTitle}</h1>
        <p class="proj__lead">{t.artLead}</p>
      </header>
    ) : (
      <Fragment>
    <div class={`proj__top${data.hero.type === 'image' ? ' proj__top--side' : ''}`}>
    <header class="proj__head">
      <a class="back" href={`${home}#${isRender ? 'models' : 'projects'}`}>{isRender ? t.backModels : t.backProjects}</a>
      <p class="kicker">{meta.platforms.map((p) => tagLabel[p]).join(' / ')}{data.stamp ? ` — ${L(data.stamp)}` : ''}</p>
      <h1 class="proj__title">{meta.title}</h1>
      <p class="proj__lead" set:html={L(lead)} />
    </header>

    <div class={`proj__hero${data.hero.type === 'image' ? ' proj__hero--image' : ''}`}>
      <Media item={data.hero} lang={lang} />
    </div>
    </div>

      </Fragment>
    )}

    {!isArt && (
      <Fragment>
    <section class="proj__intro">
      {facts.length > 0 && (
        <dl class="proj__facts">
          {facts.map((f: any) => <div><dt>{L(f.k)}</dt><dd>{L(f.v)}</dd></div>)}
        </dl>
      )}
      <div class="proj__cols">
        {rest.length > 0 && (
          <div class="proj__story">
            <h2 class="proj__sub">{t.introStory}</h2>
            <div class="copy">{rest.map((p: any) => <p set:html={L(p)} />)}</div>
          </div>
        )}
        {data.role && (
          <div class="proj__role">
            <h2 class="proj__sub">{L(data.role.title)}</h2>
            {data.role.text?.map((p: any) => <p set:html={L(p)} />)}
            {data.role.items?.length > 0 && <ul class="bullets">{data.role.items.map((b: any) => <li set:html={L(b)} />)}</ul>}
          </div>
        )}
      </div>
    </section>
      </Fragment>
    )}

    {
      groups.map((g: any) => (
        <section class="proj__group">
          {g.title && <h2 class="h2" set:html={L(g.title)} />}

          {g.details.map((d: any, i: number) => (
            <article class={`detail${i % 2 || detailCode[slug]?.[i] ? ' detail--rev' : ''}`}>
              <div class="galwrap uwin">
                <div class="uwin__bar"><span class="uwin__tab" data-kind-tab>{(d.media as any[])[0]?.type === 'video' ? 'Game' : 'Scene'}</span><span class="uwin__btns" aria-hidden="true"><i>_</i><i>&#9633;</i><i>&#215;</i></span></div>
                <div class="gal" data-gal>
                  <div class="gal__track">
                    {(d.media as any[]).map((m: any) => <div class="gal__item" data-kind={m.type === 'video' ? 'Game' : 'Scene'}><Media item={m} lang={lang} /></div>)}
                  </div>
                  {
                    (d.media as any[]).length > 1 && (
                      <>
                        <button type="button" class="gal__btn gal__btn--prev" aria-label={t.galleryPrev}>&#8592;</button>
                        <button type="button" class="gal__btn gal__btn--next" aria-label={t.galleryNext}>&#8594;</button>
                        <span class="gal__count" aria-hidden="true" />
                      </>
                    )
                  }
                </div>
                {
                  (d.media as any[]).length > 1 && (
                    <div class="gal__tabs" role="tablist">
                      {(d.media as any[]).map((m: any, k: number) => (
                        <button type="button" role="tab" aria-selected={k === 0} data-i={k}>{m.type === 'video' ? t.kindVideo : m.type === 'diagram' ? t.kindDiagram : t.kindImage}</button>
                      ))}
                    </div>
                  )
                }
              </div>
              <div class="detail__text">
                <h3 class="detail__title" set:html={L(d.title)} />
                {d.lead && <p class="detail__lead" set:html={L(d.lead)} />}
                {d.bullets.length > 0 && <ul class="bullets">{d.bullets.map((b: any) => <li set:html={L(b)} />)}</ul>}
                {d.paragraphs.length > 0 && <div class="copy">{d.paragraphs.map((p: any) => <p set:html={L(p)} />)}</div>}
              </div>
              {detailCode[slug]?.[i] && (
                <div class="under">
                  {detailCode[slug]?.[i] && (
                    <div class="codebox codewin" data-codewin>
                      <div class="codebox__meta"><span>{detailCode[slug][i].file}</span><em>{L(detailCode[slug][i].credit)}</em></div>
                      <pre><code set:html={highlight(detailCode[slug][i].code)}></code></pre>
                      <div class="codebox__foot">
                        <p class="codebox__note">{L(detailCode[slug][i].note)}</p>
                        <button type="button" class="codebox__toggle" aria-expanded="false" data-more={t.codeMore} data-less={t.codeLess} data-lines={detailCode[slug][i].code.split('\n').length}></button>
                      </div>
                    </div>
                  )}
                </div>
              )}
            </article>
          ))}

          {g.compares.map((c: any, i: number) => (
            <article class={`detail compare${c.ratio === '56 / 69' ? ' compare--portrait' : ''}${i % 2 ? ' compare--rev' : ''}`}>
              <div class="ba" style={`--ar:${c.ratio ?? '16 / 9'}`} data-ba>
                <img class="ba__img" src={`/${c.after.src}`} alt={L(c.after.alt)} loading="lazy" />
                <div class="ba__before"><img class="ba__img" src={`/${c.before.src}`} alt={L(c.before.alt)} loading="lazy" /></div>
                <span class="ba__label ba__label--before" set:html={L(c.beforeLabel)} />
                <span class="ba__label ba__label--after" set:html={L(c.afterLabel)} />
                <div class="ba__handle" aria-hidden="true" />
                <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={`${t.compareHint}: ${L(c.beforeLabel)} / ${L(c.afterLabel)}`} />
              </div>
              <div class="detail__text">
                <h3 class="detail__title" set:html={L(c.title)} />
                <p class="detail__lead" set:html={L(c.text)} />
                {c.facts.length > 0 && <ul class="bullets">{c.facts.map((f: any) => <li set:html={L(f)} />)}</ul>}
              </div>
            </article>
          ))}

          {
            g.models.length > 0 && (
              <div class="minimodels">
                {groupModels(g).map((m: any) => (
                  <a class="cell" href={`${home}#models`}>
                    <span class="cell__media"><img src={m.image} alt="" loading="lazy" /></span>
                    <span class="cell__cap"><span class="cell__title">{m.title}</span><span class="cell__tags">3D</span></span>
                  </a>
                ))}
                <p class="note">{t.modelsFromProject}</p>
              </div>
            )
          }

          {
            g.gallery.length > 0 && (
              <div class="strip">
                {g.gallery.map((m: any) => (
                  <div class={`strip__item${m.type === 'image' ? ' strip__item--zoom' : ''}`}><Media item={m} lang={lang} /></div>
                ))}
              </div>
            )
          }
        </section>
      ))
    }

    {/* shortcut: specs and pipeline are placeholders, hidden until the real numbers are written; set to true to show them */}
    {isArt && SHOW_ART_SPECS && (
      <section class="proj__group">
        <h2 class="h2">{t.artSpecs}</h2>
        <dl class="specs">
          <div><dt>Style</dt><dd>Low-poly, PSX-inspired</dd></div>
          <div><dt>Triangles</dt><dd>TODO</dd></div>
          <div><dt>Textures</dt><dd>TODO</dd></div>
          <div><dt>Made in</dt><dd>Blender, then Unity</dd></div>
        </dl>
        <h2 class="h2">{t.artPipeline}</h2>
        <ol class="steps">
          <li>TODO: modelling and UV</li>
          <li>TODO: texturing</li>
          <li>TODO: export and import in Unity</li>
        </ol>
      </section>
    )}

    {hasArtPage && !isArt && (
      <a class="artcard" href={`${hrefOf(slug)}art/`}>
        <span class="kicker">{t.artCardKicker}</span>
        <strong>{t.artCardTitle}</strong>
        <span>{t.artCardText}</span>
        <em>{t.artCardGo} &#8594;</em>
      </a>
    )}

    <nav class="pager" aria-label="Projects">
      <a class="pager__link" href={hrefOf(prev.slug)}><span>&#8592; {t.prevProject}</span>{prev.title}</a>
      <a class="pager__link pager__link--next" href={hrefOf(next.slug)}><span>{t.nextProject} &#8594;</span>{next.title}</a>
    </nav>

    <dialog class="lightbox"><button type="button" class="viewer__close" data-close>{t.closeViewer}</button><img alt="" /></dialog>
  </article>

  <script>
    import { lazyVideos } from '../lib/lazyVideo';
    lazyVideos();

    // Code excerpts start folded to a few lines
    document.querySelectorAll<HTMLElement>('[data-codewin]').forEach((box) => {
      const btn = box.querySelector<HTMLButtonElement>('.codebox__toggle')!;
      const sync = () => {
        const open = box.classList.contains('is-open');
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? btn.dataset.less! : `${btn.dataset.more} (${btn.dataset.lines})`;
      };
      btn.addEventListener('click', () => { box.classList.toggle('is-open'); sync(); });
      sync();
    });

    // Carousels: arrows, a counter and one tab per picture over a scroll-snap track
    document.querySelectorAll<HTMLElement>('[data-gal]').forEach((gal) => {
      const track = gal.querySelector<HTMLElement>('.gal__track')!;
      const count = gal.querySelector<HTMLElement>('.gal__count');
      const tabs = [...(gal.parentElement?.querySelectorAll<HTMLButtonElement>('.gal__tabs [data-i]') ?? [])];
      const n = track.children.length;
      const mark = () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (count) count.textContent = `${i + 1} / ${n}`;
        tabs.forEach((tab, k) => tab.setAttribute('aria-selected', String(k === i)));
        const kind = gal.parentElement?.querySelector('[data-kind-tab]');
        if (kind) kind.textContent = (track.children[i] as HTMLElement | undefined)?.dataset.kind ?? kind.textContent;
      };
      mark();
      track.addEventListener('scroll', mark, { passive: true });
      tabs.forEach((tab, k) => tab.addEventListener('click', () => track.scrollTo({ left: k * track.clientWidth, behavior: 'smooth' })));
      gal.querySelector('.gal__btn--prev')?.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }));
      gal.querySelector('.gal__btn--next')?.addEventListener('click', () => track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }));
    });

    // Before / after sliders
    document.querySelectorAll<HTMLElement>('[data-ba]').forEach((ba) => {
      const range = ba.querySelector<HTMLInputElement>('.ba__range')!;
      const set = () => ba.style.setProperty('--pos', `${range.value}%`);
      range.addEventListener('input', set);
      set();
    });

    // Click an image in the strip to see it bigger
    const box = document.querySelector<HTMLDialogElement>('.lightbox');
    const big = box?.querySelector('img');
    document.querySelectorAll<HTMLImageElement>('.strip__item--zoom img').forEach((img) => {
      img.addEventListener('click', () => {
        if (!box || !big) return;
        big.src = img.src;
        big.alt = img.alt;
        box.showModal();
      });
    });
    // The diagram opens bigger in the same box
    document.querySelectorAll<SVGElement>('.gal__item .diagram').forEach((svg) => {
      const open = () => {
        if (!box || !big) return;
        box.querySelectorAll('.diagram').forEach((d) => d.remove());
        big.hidden = true;
        const copy = svg.cloneNode(true) as SVGElement;
        copy.removeAttribute('style');
        box.append(copy);
        box.showModal();
      };
      svg.addEventListener('click', open);
      svg.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    });
    box?.addEventListener('close', () => { box.querySelectorAll('.diagram').forEach((d) => d.remove()); if (big) big.hidden = false; });
    box?.addEventListener('click', (e) => {
      if (e.target === box || (e.target as HTMLElement).closest('[data-close]')) box.close();
    });
  </script>
</Base>
