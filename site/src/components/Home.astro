---
import Base from '../layouts/Base.astro';
import Projects, { type ProjectItem } from './Projects.tsx';
import Models, { type ModelTile } from './Models.tsx';
import { links, models, projects } from '../data/content';
import { localePath, useT, type Lang } from '../i18n/ui';
import { highlight } from '../lib/highlight';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

// Project detail pages are still to be ported: their links point to the planned routes.
const toItem = (p: (typeof projects)[number]): ProjectItem => ({
  id: p.slug,
  title: p.title,
  platforms: p.platforms,
  image: p.image,
  imageAlt: p.imageAlt[lang],
  position: p.position,
  video: p.video,
  poster: p.poster,
  desc: p.desc[lang],
  facts: p.facts?.[lang],
  href: localePath(lang, `/projects/${p.slug}/`),
});
const gameItems: ProjectItem[] = projects.filter((p) => !p.platforms.includes('3d')).map(toItem);
const renders: ModelTile[] = projects
  .filter((p) => p.platforms.includes('3d'))
  .map((p) => ({ id: p.slug, title: p.title, tag: 'Render', image: p.image, href: localePath(lang, `/projects/${p.slug}/`) }));
const modelTiles: ModelTile[] = models.map((m) => ({
  id: m.id,
  title: m.title,
  tag: m.tags[0] ?? '3D',
  image: m.image,
  sketchfab: m.sketchfab,
}));

// "Under the hood": a real gameplay clip with a simplified excerpt of its code behind a draggable handle
const hoodCode = `public interface ITurretController
{
    bool TryConsumeAmmo();
    void Recoil();
}

void ProcessFiring()
{
    if (!isFiring) return;
    if (Time.time - lastFireTime < 60 / fireRate) return;

    if (controller.TryConsumeAmmo())
    {
        lastFireTime = Time.time;
        float spread = isAiming ? adsSpread : hipFireSpread;
        float x = Random.Range(-spread, spread);
        float y = Random.Range(-spread, spread);
        Quaternion rot = barrel.rotation * Quaternion.Euler(x, y, 0f);

        Instantiate(bulletPrefab, barrel.position, rot);
        controller.Recoil();
    }
}`;
const hoodHtml = highlight(hoodCode);

// The reel: clips from existing projects, replace with a real showreel when there is one
const reel = [
  { src: '/assets/lastgunner/campagna-tank.mp4', poster: '/assets/posters/lastgunner-campagna-tank.webp', title: 'The Last Gunner' },
  { src: '/assets/lastgunner/canyon-vista.mp4', poster: '/assets/posters/lastgunner-canyon-vista.webp', title: 'The Last Gunner' },
  { src: '/assets/lastgunner/cimitero-atmosphere.mp4', poster: '/assets/posters/lastgunner-cimitero-atmosphere.webp', title: 'The Last Gunner' },
];
// name, the one-line job description and "now" are already in the lead text above the list
const aboutRows = t.card.rows.filter((_, i) => i !== 0 && i !== 2 && i !== 3);
---

<Base lang={lang}>
  <section id="top" class="hero2">
    <div class="hero2__copy">
      <p class="kicker">{t.heroKicker}</p>
      <h1 class="hero__title">{t.heroLine1} {t.heroLine2}</h1>
      <p class="hero__sub">{t.heroDesc}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#projects">{t.ctaWork}</a>
        <a class="btn" href={`mailto:${links.email}`}>{t.ctaContact}</a>
      </div>
    </div>
    <div class="uwin hood-win">
    <div class="uwin__bar"><span class="uwin__tab">Game</span><span class="uwin__tab uwin__tab--off">Script</span><span class="uwin__btns" aria-hidden="true"><i>_</i><i>&#9633;</i><i>&#215;</i></span></div>
    <figure class="hood" data-hood style="--pos:92%">
      <video class="hood__media" src="/assets/lastgunner/campagna-tank.mp4" poster="/assets/posters/lastgunner-campagna-tank.webp" muted loop playsinline aria-hidden="true"></video>
      <div class="hood__code"><pre><code set:html={hoodHtml}></code></pre></div>
      <span class="hood__tag hood__tag--l">{t.hoodCode}</span>
      <span class="hood__tag hood__tag--r">{t.hoodGame}</span>
      <div class="hood__handle" aria-hidden="true"><span>{t.hoodHint}</span></div>
      <input class="hood__range" type="range" min="0" max="100" value="92" aria-label={`${t.hoodCode} / ${t.hoodGame}`} />
      <figcaption>{t.hoodCaption}</figcaption>
    </figure>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="section__head">
      <p class="section__label">01</p>
      <h2 class="h2">{t.projectsTitle}</h2>
    </div>
    <Projects client:load items={gameItems} labels={{ view: t.viewProject }} />
  </section>

  <hr class="rule" />

  <section id="models" class="section">
    <div class="section__head">
      <p class="section__label">02</p>
      <h2 class="h2">{t.modelsTitle}</h2>
    </div>
    <Models client:load items={[...renders, ...modelTiles]} labels={{ view: t.viewProject, viewModel: t.viewModel, close: t.closeViewer }} />
    <p class="note">{t.gridNote}</p>
  </section>

  <hr class="rule" />

  <section id="about" class="section">
    <div class="section__head">
      <p class="section__label">03</p>
      <h2 class="h2">{t.aboutTitle}</h2>
    </div>
    <div class="about">
      <p class="about__lead">{t.aboutLead} <span>{t.aboutNow}</span></p>
      <dl class="facts">
        {aboutRows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <script>
    // The handle starts at the right edge, then slides to the middle once, so it is clear that it can be moved.
    const hood = document.querySelector<HTMLElement>('[data-hood]');
    const range = hood?.querySelector<HTMLInputElement>('.hood__range');
    if (hood && range) {
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) hood.querySelector('video')?.play().catch(() => {});
      const set = (v: number) => { range.value = String(v); hood.style.setProperty('--pos', `${v}%`); };
      let touched = false;
      range.addEventListener('input', () => { touched = true; set(Number(range.value)); });
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) set(50);
      else {
        const t0 = performance.now() + 700;
        const step = (now: number) => {
          if (touched) return;
          const k = Math.min(1, Math.max(0, (now - t0) / 1400));
          set(92 - 42 * (1 - Math.pow(1 - k, 3)));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    }
  </script>
</Base>
