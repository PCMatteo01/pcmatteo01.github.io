---
interface Item {
  type: 'video' | 'image';
  src: string;
  poster?: string;
  alt?: { en: string; it: string };
  position?: string;
  fit?: string;
}

interface Props {
  item: Item;
  lang: 'en' | 'it';
}

const { item, lang } = Astro.props;
const style = [item.position && `object-position:${item.position}`, item.fit && `object-fit:${item.fit}`].filter(Boolean).join(';');
---

{
  item.type === 'video' ? (
    <video data-src={`/${item.src}`} poster={item.poster ? `/${item.poster}` : undefined} muted loop playsinline preload="none" aria-hidden="true" style={style || undefined} />
  ) : (
    <img src={`/${item.src}`} alt={item.alt?.[lang] ?? ''} loading="lazy" style={style || undefined} />
  )
}
